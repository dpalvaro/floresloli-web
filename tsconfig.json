{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["astro/client"]
  },
  "include": ["src/**/*.ts", "compartido/**/*.ts", "src/env.d.ts"],
  "exclude": ["dist", "node_modules", "functions", "pruebas", "herramientas"]
}
