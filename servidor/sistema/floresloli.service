# Tienda online de Flores y Plantas Loli (servidor/servidor.ts).
# Se instala en /etc/systemd/system/ con preparar.sh. Corre con un usuario sin
# privilegios, encerrado: solo puede escribir en la carpeta de la base de datos.

[Unit]
Description=Tienda online de Flores y Plantas Loli
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=floresloli
Group=floresloli
WorkingDirectory=/srv/floresloli/actual
EnvironmentFile=/etc/floresloli/entorno
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning servidor/servidor.ts
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# Aislamiento
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/floresloli
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# Límites
MemoryMax=768M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
