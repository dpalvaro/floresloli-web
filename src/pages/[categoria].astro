---
import Base from '../layouts/Base.astro';
import ComoLlega from '../components/ComoLlega.astro';
import Migas from '../components/Migas.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import type { Categoria } from '../../compartido/catalogo.ts';
import { productosDeCategoria, rutaCategoria } from '../../compartido/catalogo.ts';
import { NEGOCIO, enlaceTelefono } from '../../compartido/negocio.ts';
import { ENTORNO } from '../lib/entorno.ts';
import { RUTA_A_MEDIDA, RUTA_TIENDA, categoriasConPagina } from '../lib/rutas.ts';
import { jsonLdMigas } from '../lib/seo.ts';

export function getStaticPaths() {
  return categoriasConPagina().map((categoria) => ({ params: { categoria: categoria.slug }, props: { categoria } }));
}

interface Props {
  categoria: Categoria;
}
const { categoria: c } = Astro.props;
const productos = productosDeCategoria(c.id, ENTORNO);
const otras = categoriasConPagina().filter((x) => x.id !== c.id);
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Flores y plantas', ruta: RUTA_TIENDA },
  { nombre: c.nombre, ruta: rutaCategoria(c) },
];
---

<Base titulo={c.titulo} descripcion={c.descripcion} jsonLd={[jsonLdMigas(migas)]}>
  <div class="envoltura cabeza-pagina">
    <Migas migas={migas} />
    <h1>{c.titulo}</h1>
    <p class="entrada">{c.intro}</p>
    {
      c.sobrio && (
        <p class="llamar">
          <a class="boton oscuro" href={enlaceTelefono(NEGOCIO.telefono)}>
            Llamar al {NEGOCIO.telefono}
          </a>
        </p>
      )
    }
  </div>

  <section class="seccion" aria-label={c.nombre}>
    <div class="envoltura">
      <ul class="rejilla-productos">
        {productos.map((p, i) => <TarjetaProducto producto={p} nivel={2} principal={i < 2} />)}
      </ul>
    </div>
  </section>

  {
    c.id === 'ramos' && (
      <section class="seccion">
        <div class="envoltura">
          <div class="aviso medida">
            <p>
              <strong>¿No sabes cuál elegir?</strong> Dinos cuánto quieres gastar y preparamos el ramo con la flor más fresca del día.{' '}
              <a href={RUTA_A_MEDIDA}>Pedir un ramo a mi medida</a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="seccion">
    <div class="envoltura">
      <ComoLlega sobrio={c.sobrio} />
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-otras">
    <div class="envoltura">
      <h2 id="t-otras" class="titulo-otras">También en la tienda</h2>
      <ul class="enlaces-relacionados">
        {
          otras.map((o) => (
            <li>
              <a href={rutaCategoria(o)}>{o.nombre}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .llamar { margin-top: 22px; }
  .medida { max-width: 68ch; }
  .titulo-otras { font-size: clamp(1.5rem, 3.4vw, 2rem); margin-bottom: 0.7em; }
</style>
