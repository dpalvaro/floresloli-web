---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { euros, preciosALaVista, productoPorId, productosDeTienda, rutaCategoria, rutaOcasion } from '../../compartido/catalogo.ts';
import { NEGOCIO, direccionCompleta, enlaceComoLlegar, enlaceTelefono, enlaceWhatsApp, horarioParaMostrar } from '../../compartido/negocio.ts';
import { TIENDA } from '../../compartido/tienda.ts';
import { ENTORNO } from '../lib/entorno.ts';
import { foto } from '../lib/imagenes.ts';
import { RUTA_A_MEDIDA, RUTA_CONTACTO, RUTA_EVENTOS, RUTA_HOSPITAL, RUTA_REPARTO, RUTA_TIENDA, categoriasConPagina, ocasionesConPagina } from '../lib/rutas.ts';
import { jsonLdFloristeria } from '../lib/seo.ts';

const catalogo = productosDeTienda(ENTORNO);
const destacados = [...catalogo.filter((p) => p.destacado), ...catalogo.filter((p) => !p.destacado)].slice(0, 8);

const aMedida = productoPorId('ramo-a-tu-medida')!;
const importesALaVista = preciosALaVista(aMedida, ENTORNO);

const condolencias = categoriasConPagina().find((c) => c.id === 'condolencias');
const ocasiones = ocasionesConPagina();
const horario = horarioParaMostrar();
const horarioEnTexto = horario
  .filter((h) => h.horas[0] !== 'Cerrado')
  .map((h) => `${h.dias}, ${h.horas.join(' y ')}`)
  .join('. ');

const fotoRamo = foto('ramo')!;
const fotoMedida = foto('centro-lilium')!;
const fotoHospital = foto('ramo-hospital')!;
const fotoFachada = foto('fachada')!;
const cartel = await getImage({ src: foto('taller-poster')!, width: 432, format: 'webp', quality: 70 });
const envioToledo = TIENDA.entrega.domicilio.zonas[0]?.precio;
---

<Base
  titulo="Floristería en el Polígono de Toledo"
  descripcion="Ramos, plantas y centros hechos a mano en el Polígono de Toledo (C/ Río Alberche, 30). Recógelos en la tienda o te los llevamos a casa y al Hospital Universitario."
  jsonLd={[jsonLdFloristeria(['/social/portada.jpg'])]}
>
  <section class="portada">
    <div class="envoltura portada-rejilla">
      <div class="portada-texto">
        <h1>Flores hechas a mano en el Polígono de Toledo</h1>
        <p class="entrada">
          Ramos, plantas y centros que preparamos en la tienda. Recógelos en la calle Río Alberche o te los llevamos a casa y al Hospital
          Universitario.
        </p>
        <div class="botones">
          <a class="boton oscuro grande" href={RUTA_TIENDA}>Ver flores y plantas</a>
          <a class="boton wa grande" href={enlaceWhatsApp()} rel="noopener">
            <Icono nombre="whatsapp" /> Encargar por WhatsApp
          </a>
        </div>
        <p class="apertura" data-apertura>{horarioEnTexto}.</p>
      </div>
      <div class="portada-foto">
        <Picture
          src={fotoRamo}
          alt="Ramo de gerbera rosa, lilium y margaritas blancas recién atado en la tienda"
          widths={[360, 540, 720, 1000]}
          sizes="(min-width: 900px) 440px, 88vw"
          formats={['webp']}
          fallbackFormat="jpg"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="feston" aria-hidden="true"></div>
  </section>

  <section class="seccion para-que">
    <div class="envoltura">
      <h2 class="solo-lectores">¿Para qué son las flores?</h2>
      <ul class="pastillas">
        {
          ocasiones.map((o) => (
            <li>
              <a href={rutaOcasion(o)}>{o.nombre}</a>
            </li>
          ))
        }
        <li><a href={RUTA_HOSPITAL}>Para el hospital</a></li>
        {
          condolencias && (
            <li>
              <a href={rutaCategoria(condolencias)}>Condolencias</a>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-destacados">
    <div class="envoltura">
      <div class="cabeza-seccion">
        <div>
          <h2 id="t-destacados">Recién salido del mostrador</h2>
          <p>Ramos, plantas y centros que preparamos cada semana con la flor que entra.</p>
        </div>
        <a class="enlace-mas" href={RUTA_TIENDA}>Ver todo el catálogo</a>
      </div>
      <ul class="rejilla-productos">
        {destacados.map((p) => <TarjetaProducto producto={p} />)}
      </ul>
    </div>
  </section>

  <section class="seccion fondo banda-clara a-medida" aria-labelledby="t-medida">
    <div class="envoltura dos-columnas">
      <div>
        <h2 id="t-medida">Dinos cuánto quieres gastar y hacemos el ramo</h2>
        <p class="entrada">
          Es lo que más nos piden en el mostrador. Tú pones el importe y, si quieres, los colores. Elegimos la flor más fresca del día y lo
          montamos a mano.
        </p>
        {
          importesALaVista ? (
            <ul class="importes" aria-label="Importes habituales">
              {TIENDA.ramoAMedida.importes.map((importe) => (
                <li>
                  <a class="boton linea" href={`${RUTA_A_MEDIDA}?importe=${importe}`}>
                    {euros(importe)}
                  </a>
                </li>
              ))}
              <li>
                <a class="boton linea" href={RUTA_A_MEDIDA}>
                  Otro importe
                </a>
              </li>
            </ul>
          ) : (
            <a class="boton" href={RUTA_A_MEDIDA}>
              Pedir un ramo a mi medida
            </a>
          )
        }
      </div>
      <div class="marco foto-medida">
        <Picture
          src={fotoMedida}
          alt="Composición de lilium, hortensia y rosas recién montada en la tienda"
          widths={[320, 540]}
          sizes="(min-width: 900px) 380px, 88vw"
          formats={['webp']}
          fallbackFormat="jpg"
          quality={72}
        />
      </div>
    </div>
  </section>

  <section class="seccion fondo banda-oscura hospital" aria-labelledby="t-hospital">
    <div class="envoltura dos-columnas">
      <div class="marco foto-hospital">
        <Picture
          src={fotoHospital}
          alt="Ramo de margaritas blancas y gerberas rosas, de perfume suave"
          widths={[320, 480, 720]}
          sizes="(min-width: 900px) 380px, 88vw"
          formats={['webp']}
          fallbackFormat="jpg"
          quality={72}
        />
      </div>
      <div>
        <h2 id="t-hospital">Flores al Hospital Universitario de Toledo</h2>
        <p class="entrada">
          Estamos en el mismo barrio. Dinos el nombre de la persona y, si la sabes, la planta y la habitación, y se lo llevamos en mano.
        </p>
        <a class="boton claro" href={RUTA_HOSPITAL}>Enviar flores al hospital</a>
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-como">
    <div class="envoltura">
      <div class="cabeza-seccion">
        <h2 id="t-como">Cómo se encarga</h2>
      </div>
      <ol class="pasos">
        <li>
          <h3>Elige</h3>
          <p>Un ramo, una planta o un centro. O dinos el importe y lo hacemos a tu medida.</p>
        </li>
        <li>
          <h3>Dinos cuándo y dónde</h3>
          <p>Para recoger en la tienda, en casa o en el hospital. Añade la dedicatoria: la escribimos a mano en una tarjeta.</p>
        </li>
        <li>
          <h3>Lo preparamos</h3>
          <p>Lo montamos a mano en la tienda, con flor de temporada, para el día que nos digas.</p>
        </li>
      </ol>

      <ul class="entregas">
        <li>
          <Icono nombre="tienda" tamano={28} />
          <div>
            <h3>Recoger en la tienda</h3>
            <p>Gratis. Te lo dejamos preparado en la calle Río Alberche, 30.</p>
          </div>
        </li>
        <li>
          <Icono nombre="reparto" tamano={28} />
          <div>
            <h3>A domicilio en Toledo</h3>
            <p>
              {envioToledo != null ? `${euros(envioToledo)}. ` : ''}A los pueblos cercanos, según la distancia. <a href={RUTA_REPARTO}>Ver el reparto</a>
            </p>
          </div>
        </li>
        <li>
          <Icono nombre="hospital" tamano={28} />
          <div>
            <h3>Al Hospital Universitario</h3>
            <p>
              En el mismo barrio que la tienda. <a href={RUTA_HOSPITAL}>Cómo funciona</a>
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="seccion fondo banda-blanca" aria-labelledby="t-taller">
    <div class="envoltura dos-columnas taller">
      <div>
        <h2 id="t-taller">Cada ramo se monta a mano</h2>
        <p class="entrada">
          Trabajamos con flor fresca de temporada, así que no hay dos ramos iguales. Si nos dices para quién es, acertamos mejor con los colores.
        </p>
        <p>
          También preparamos flores para bodas, comuniones y empresas. Cuéntanos qué necesitas y te hacemos un presupuesto sin compromiso.
        </p>
        <a class="boton linea" href={RUTA_EVENTOS}>Pedir presupuesto para un evento</a>
      </div>
      <div class="marco video-taller">
        <video muted loop playsinline controls preload="none" poster={cartel.src} width="432" height="768" data-video aria-label="Montaje de un centro de flores en la tienda">
          <source src="/video/taller.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-tienda">
    <div class="envoltura dos-columnas tienda">
      <div class="marco foto-tienda">
        <Picture
          src={fotoFachada}
          alt="Fachada de Flores y Plantas Loli, con el rótulo lima y plantas en la acera"
          widths={[480, 720, 1000, 1400]}
          sizes="(min-width: 900px) 560px, 92vw"
          formats={['webp']}
          fallbackFormat="jpg"
          quality={70}
        />
      </div>
      <div>
        <h2 id="t-tienda">Ven a vernos al Polígono</h2>
        <dl class="datos">
          <div>
            <dt>Dirección</dt>
            <dd>
              {direccionCompleta()}
              <br />
              Barrio de {NEGOCIO.direccion.barrioOficial}
            </dd>
          </div>
          <div>
            <dt>Horario</dt>
            <dd>
              <table class="horario">
                <tbody>
                  {
                    horario.map((fila) => (
                      <tr>
                        <th scope="row">{fila.dias}</th>
                        <td>{fila.horas.join(' y ')}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </dd>
          </div>
        </dl>
        <div class="botones">
          <a class="boton" href={enlaceComoLlegar()} rel="noopener"><Icono nombre="mapa" /> Cómo llegar</a>
          <a class="boton linea" href={enlaceTelefono(NEGOCIO.telefono)}><Icono nombre="telefono" /> {NEGOCIO.telefono}</a>
        </div>
        <p class="mas-tienda"><a href={RUTA_CONTACTO}>Más sobre la tienda</a></p>
      </div>
    </div>
  </section>

  <script>
    // El vídeo solo se descarga y arranca cuando se ve, y nunca si el usuario pide menos movimiento.
    const video = document.querySelector<HTMLVideoElement>('[data-video]');
    if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) video.play().catch(() => {});
            else video.pause();
          }
        },
        { threshold: 0.5 },
      );
      observador.observe(video);
    }
  </script>
</Base>

<style>
  .portada { position: relative; background: var(--lima); padding-block: clamp(28px, 5vw, 56px) 0; }
  .portada .feston { position: absolute; left: 0; right: 0; top: 100%; }
  .portada-rejilla { display: grid; gap: 28px; }
  .portada h1 { margin-bottom: 0.35em; }
  .portada .entrada { color: var(--violeta-osc); margin-bottom: 1.4em; }
  .apertura { margin-top: 18px; font-weight: 600; color: var(--violeta-osc); font-size: 0.96rem; }
  .apertura[data-abierta='true']::before,
  .apertura[data-abierta='false']::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--verde);
  }
  .apertura[data-abierta='false']::before { background: #8a8698; }
  .portada-foto { position: relative; z-index: 1; margin-bottom: -44px; max-width: 440px; justify-self: center; width: 100%; }
  .portada-foto :global(img) { border-radius: var(--radio); aspect-ratio: 4 / 5; object-fit: cover; width: 100%; box-shadow: 0 24px 40px -24px rgba(43, 35, 80, 0.55); }

  .para-que { padding-top: calc(44px + clamp(36px, 6vw, 64px)); padding-bottom: clamp(36px, 6vw, 64px); }
  .pastillas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pastillas li { margin: 0; }
  .pastillas a {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--blanco);
    border: 1.5px solid var(--linea);
    color: var(--violeta-osc);
    font-weight: 600;
    text-decoration: none;
  }
  .pastillas a:hover { border-color: var(--violeta); background: var(--violeta-claro); }

  .dos-columnas { display: grid; gap: 32px; align-items: center; }
  .dos-columnas .entrada { margin-block: 0.8em 1.3em; }
  .banda-clara .entrada { color: var(--tinta); }

  .importes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .importes li { margin: 0; }
  .importes .boton { background: var(--blanco); min-width: 84px; }
  .importes .boton:hover { background: var(--violeta-osc); }
  .foto-medida, .foto-hospital, .video-taller { max-width: 380px; width: 100%; justify-self: center; }
  .video-taller { aspect-ratio: 9 / 16; background: #1c1637; }
  .video-taller video { width: 100%; height: 100%; object-fit: cover; }
  .foto-tienda { aspect-ratio: 3 / 2; }

  .pasos { list-style: none; counter-reset: paso; margin: 0 0 clamp(36px, 6vw, 56px); padding: 0; display: grid; gap: 28px; }
  .pasos li { counter-increment: paso; margin: 0; padding-left: 62px; position: relative; }
  .pasos li::before {
    content: counter(paso);
    position: absolute;
    left: 0;
    top: -4px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--lima);
    color: var(--violeta-osc);
    font: 400 1.6rem/46px var(--serif);
    text-align: center;
  }
  .pasos h3 { margin-bottom: 6px; }
  .pasos p { color: var(--gris); max-width: 38ch; }

  .entregas { list-style: none; margin: 0; padding: 28px 0 0; display: grid; gap: 22px; border-top: 1px solid var(--linea); }
  .entregas li { margin: 0; display: grid; grid-template-columns: 34px 1fr; gap: 14px; color: var(--violeta); }
  .entregas h3 { font: 600 1.05rem/1.3 var(--sans); letter-spacing: 0; margin-bottom: 2px; }
  .entregas p { color: var(--gris); font-size: 0.96rem; }

  .tienda .datos { margin-block: 20px 24px; }
  .mas-tienda { margin-top: 18px; }

  @media (min-width: 900px) {
    .portada-rejilla { grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center; }
    .portada-texto { padding-bottom: 56px; }
    .portada-foto { margin-bottom: -72px; justify-self: end; }
    .para-que { padding-top: calc(72px + 56px); }
    .dos-columnas { grid-template-columns: 1fr 1fr; gap: 64px; }
    .a-medida .dos-columnas, .taller { grid-template-columns: 1.25fr 0.75fr; }
    .hospital .dos-columnas { grid-template-columns: 0.75fr 1.25fr; }
    .pasos { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .entregas { grid-template-columns: repeat(3, 1fr); gap: 40px; }
  }
</style>
